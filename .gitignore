# Node / tooling
node_modules/

# 本项目的运行时输出。正式 manifest 未来会放入明确的用户数据目录，默认不进 Git。
.tmp/
tmp/
logs/
*.log
*.har

# 冷迁移运行态 manifest 会记录本机绝对路径、远端 fileId/taskId 与断点信息。
# 它们是用户数据，不属于源码，也不能误提交到 Git。
manifests/

# 任何可能包含真实 PikPak/STS/HTTP 授权信息的抓包或响应转储都禁止提交。
secrets/
credentials/
*.secret.json
*.tokens.json
*.cookies.json
*auth*.json
*sts*.json

# 网络/浏览器调试临时产物
fixtures/private/
artifacts/private/

# OS / editor
.DS_Store
Thumbs.db
.vscode/settings.json
